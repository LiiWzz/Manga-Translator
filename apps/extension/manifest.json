{
  "manifest_version": 3,
  "name": "Manga Thai Reader",
  "version": "0.4.0",
  "description": "Non-destructive manga translation in a Chrome Side Panel.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://cdn.asurascans.com/*"
  ],
  "action": {
    "default_title": "Open Thai Reader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "reader-panel.html"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
