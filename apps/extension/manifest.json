{
  "manifest_version": 3,
  "name": "Manga Thai Reader",
  "version": "0.4.0",
  "description": "Non-destructive manga translation in a Chrome Side Panel.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://cdn.asurascans.com/*"
  ],
  "action": {
    "default_title": "Open Thai Reader"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "reader-panel.html"
  }
}
